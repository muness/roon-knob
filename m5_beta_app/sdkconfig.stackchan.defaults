CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_SPIRAM=y
# Kizz runs on M5StackChan K151's factory profile: ESP32-S3 quad PSRAM.
# OPI/octal mode makes the ROM abort before app_main() on this board.
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
# ESP-IDF recommends static TX buffers when PSRAM is enabled. Kizz otherwise
# allocates radio buffers while enrollment and now-playing traffic overlap,
# which can starve the Wi-Fi transmit path under its full voice workload.
CONFIG_ESP_WIFI_STATIC_TX_BUFFER=y
# Two buffers reserve enough radio progress for the sequential enrollment
# upload without consuming the internal DMA heap needed by M5Unified's mic.
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=2
CONFIG_LWIP_LOCAL_HOSTNAME="hiphi-kizz-beta"
# Voice, enrollment, now-playing, DNS, and reconnect overlap can exceed IDF's
# default budget of ten. Keep headroom so one stalled LAN connection cannot
# starve the independent voice and training transports.
CONFIG_LWIP_MAX_SOCKETS=16
# Kizz polls now-playing every two seconds while charging. The lwIP default
# retains an actively closed socket for two minutes, enough to starve voice and
# enrollment despite the expanded socket table. Five-second MSL preserves a
# bounded stale-packet window while letting one-shot LAN requests age out.
CONFIG_LWIP_TCP_MSL=5000
CONFIG_M5_PLATFORM_EXPECT_STACKCHAN=y
CONFIG_M5_PLATFORM_STACKCHAN_VOICE_WS_URI="ws://192.168.1.101:8088/voice/v1"
# Enrollment is an independent deployment. Never derive this from the UHC URL.
CONFIG_M5_PLATFORM_ENROLLMENT_WS_URI="ws://192.168.1.101:8091/v1/device"
CONFIG_M5_PLATFORM_DEVICE_ID="kizz-1"
CONFIG_M5_PLATFORM_DEVICE_PROFILE="m5stack_stackchan_k151_cores3_room_scale_v2"
CONFIG_FREERTOS_HZ=1000
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.stackchan.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.stackchan.csv"
CONFIG_SR_VADN_VADNET1_MEDIUM=y
CONFIG_SR_WN_WN9L_HISTACKCHAN_TTS3=y
