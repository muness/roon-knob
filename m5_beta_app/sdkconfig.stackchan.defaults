CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_SPIRAM=y
# Kizz runs on M5StackChan K151's factory profile: ESP32-S3 quad PSRAM.
# OPI/octal mode makes the ROM abort before app_main() on this board.
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_LWIP_LOCAL_HOSTNAME="hiphi-kizz-beta"
CONFIG_M5_PLATFORM_EXPECT_STACKCHAN=y
CONFIG_FREERTOS_HZ=1000
