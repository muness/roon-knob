CONFIG_WIFI_SSID="HIPHI_DIAL_AP"
CONFIG_WIFI_PASSWORD="rotary123"
CONFIG_EXAMPLE_IPV6=0
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000
CONFIG_PARTITION_TABLE_MD5=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# v4's non-debug release profile (-O2).
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# Shared configuration startup canonicalizes the 570-byte V3 compatibility
# record through nested storage/read-back frames. Match the Frame target's
# proven startup budget instead of relying on ESP-IDF's 3584-byte default.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Wi-Fi provisioning starts the captive portal from ESP-IDF's default event-loop
# task (sys_evt). Its 2304-byte default overflows under the PERF build.
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

# PSRAM Configuration (required for artwork RGB565 buffers)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=49152
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
# Required by the explicitly PSRAM-backed, network-only bridge worker stack.
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y

# WiFi memory optimization (needed when BT is also enabled)
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=8
CONFIG_ESP_WIFI_TX_BUFFER_TYPE=1
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_CACHE_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_RX_BA_WIN=6
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=16

# Network identity - replace "espressif" with project name for NetBIOS/LLMNR
CONFIG_LWIP_LOCAL_HOSTNAME="hiphi-dial"
CONFIG_LWIP_NETIF_HOSTNAME=y

# Brownout detection - lower threshold for battery operation
# Level 4 (2.50V) allows WiFi current spikes without false triggers
# Level 7 (2.80V default) causes boot failures on battery due to WiFi inrush
CONFIG_ESP_BROWNOUT_DET=y
CONFIG_ESP_BROWNOUT_DET_LVL_SEL_4=y
CONFIG_ESP_BROWNOUT_DET_LVL=4
CONFIG_BROWNOUT_DET_LVL_SEL_4=y
CONFIG_ESP32S3_BROWNOUT_DET_LVL_SEL_4=y
CONFIG_BROWNOUT_DET_LVL=4
CONFIG_ESP32S3_BROWNOUT_DET_LVL=4

# LVGL JPEG Decoder - Disabled (using ESP_NEW_JPEG instead)
# CONFIG_LV_USE_TJPGD is not set

# LVGL Examples - Disabled (unused, bloats build)
# CONFIG_LV_BUILD_EXAMPLES is not set

# LVGL Matrix Rotation - Required for software display rotation
CONFIG_LV_USE_FLOAT=y
CONFIG_LV_USE_MATRIX=y
CONFIG_LV_DRAW_TRANSFORM_USE_MATRIX=y

# Keep a small latency-sensitive LVGL base heap in internal SRAM. app_main adds
# a 72 KiB PSRAM expansion pool before creating display/UI objects.
CONFIG_LV_MEM_SIZE_KILOBYTES=24
# LVGL compiles its TLSF maximum pool size from the base plus this expansion
# budget. Without it, lv_mem_add_pool() rejects the 72 KiB PSRAM pool.
CONFIG_LV_MEM_POOL_EXPAND_SIZE_KILOBYTES=72

# LVGL Fonts - built-in Montserrat for fallback only
# Main fonts are pre-rendered bitmap fonts (Charis SIL + Material Symbols)
# generated at build time via scripts/generate_fonts.sh
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y

# Arabic/Persian text shaping (contextual glyph forms for bitmap fonts)
CONFIG_LV_USE_ARABIC_PERSIAN_CHARS=y

# Display Sleep Settings
CONFIG_RK_DISPLAY_DIM_TIMEOUT_SEC=30
CONFIG_RK_DISPLAY_SLEEP_TIMEOUT_SEC=60
CONFIG_RK_BACKLIGHT_NORMAL=100
CONFIG_RK_BACKLIGHT_DIM=25

# HTTP Server - larger header buffer for modern browsers
CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048

# Power Management - enables CPU frequency scaling (optional, disabled by default in firmware)
# When enabled in bridge config, allows CPU to scale down when idle to save power
# Trade-off: adds 0.2-40us interrupt latency
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y

# BLE HID host for pairing a separate media remote. ESP32-S3 supports BLE,
# although it does not support Classic Bluetooth. The shipping Dial firmware
# includes this capability; its device-local setting defaults to disabled.
CONFIG_RK_BLE_HID_HOST=y
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_SM_SC=y
CONFIG_BT_NIMBLE_HID_SERVICE=y
# This target is a single BLE HID remote host. Keep NimBLE's dynamic buffers
# out of the DMA-constrained internal heap used by the LVGL SPI display.
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_BT_NIMBLE_PINNED_TO_CORE_0=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
## ESP-IDF's esp_hid BLE-host source is conditionally compiled behind the
## HID-service setting, which itself requires GATT server/peripheral.  These
## are therefore the minimum compatibility roles for its HID client wrapper;
## the firmware does not advertise a local HID device.
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_GATT_CLIENT=y
CONFIG_BT_NIMBLE_GATT_SERVER=y
# ESP-IDF 5.5's NVS bond-store implementation indexes i + 1 while sorting;
# a one-entry array trips -Werror=array-bounds.  Two is its safe minimum.
CONFIG_BT_NIMBLE_MAX_BONDS=2
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_MAX_CCCDS=2
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=128
CONFIG_BT_NIMBLE_ATT_MAX_PREP_ENTRIES=4
CONFIG_BT_NIMBLE_GATT_MAX_PROCS=2
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=6
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_SIZE=128
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=8
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_SIZE=192
CONFIG_BT_NIMBLE_TRANSPORT_ACL_FROM_LL_COUNT=8
CONFIG_BT_NIMBLE_TRANSPORT_ACL_SIZE=128
CONFIG_BT_NIMBLE_TRANSPORT_EVT_COUNT=10
CONFIG_BT_NIMBLE_TRANSPORT_EVT_DISCARD_COUNT=4
CONFIG_BT_NIMBLE_PROX_SERVICE=n
CONFIG_BT_NIMBLE_ANS_SERVICE=n
CONFIG_BT_NIMBLE_CTS_SERVICE=n
CONFIG_BT_NIMBLE_HTP_SERVICE=n
CONFIG_BT_NIMBLE_IPSS_SERVICE=n
CONFIG_BT_NIMBLE_TPS_SERVICE=n
CONFIG_BT_NIMBLE_IAS_SERVICE=n
CONFIG_BT_NIMBLE_LLS_SERVICE=n
CONFIG_BT_NIMBLE_SPS_SERVICE=n
CONFIG_BT_NIMBLE_HR_SERVICE=n
CONFIG_BT_NIMBLE_BAS_SERVICE=n
CONFIG_BT_NIMBLE_DIS_SERVICE=n
CONFIG_LWIP_NETIF_HOSTNAME=y
